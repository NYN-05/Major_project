# Datasets (large external downloads)
DFDC_Dataset/
FF++/

# Dev scratch — tests, temp scripts, screenshots, logs (see AGENTS.md)
Scrape/

# Secrets — keep .env.example tracked
.env
.env.*
!.env.example

# Python caches / virtualenv / build artifacts
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
build/
*.egg-info/

# Node deps, frontend build output, Playwright MCP captures
node_modules/
dist/
.playwright-mcp/

# OpenCode tooling deps (commands/*.md stay tracked; .opencode/.gitignore covers its package files)
.opencode/node_modules/

# Model weights & pickled models (large / regenerated per run)
# exception: small face detector used by stage 1 stays tracked
*.pkl
*.pt
!WORKING/frame/weights/yolov8n-face-lindevs.pt

# Generated pipeline datasets/features/results (all output/ dirs are regenerated)
*.csv
output/

# Logs, temp test media
*.log
WORKING/frame/test*.mp4

# Tool-generated output dirs
graphify-out/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
